// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model College {
  id          String @id @default(uuid())
  name        String @unique
  collegeId   String @unique
  collegeType String @default("other")
  city        String
  state       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

model User {
  // userInfo
  id              String  @id @default(uuid())
  clerkId         String  @unique
  email           String  @unique
  firstName       String
  lastName        String
  username        String  @unique
  profileImageUrl String?
  //collegeInfo
  collegeId       String?
  degree          String?
  branch          String?
  graduationYear  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // foreignKey
  college           College?            @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  leetcodeStats     LeetCodeStats?
  submissionHistory SubmissionHistory[]
}

model LeetCodeStats {
  id                    String @id @default(uuid())
  userId                String @unique
  // stats
  userName              String
  globalRank            Int    @default(5000001)
  totalQuestionsSolved  Int    @default(0)
  mediumQuestionsSolved Int    @default(0)
  hardQuestionsSolved   Int    @default(0)
  easyQuestionsSolved   Int    @default(0)
  badges                Json   @default("[]")

  // days
  activeDays    Int @default(0)
  maxStreak     Int @default(0)
  currentStreak Int @default(0)

  // submissions
  submissionHeatMap Json @default("{}") // FIXED: Changed to empty object

  // tag
  fundamentalTag  Json @default("[]")
  intermediateTag Json @default("[]")
  advancedTag     Json @default("[]")

  // profile
  avatarUrl          String  @default("https://assets.leetcode.com/users/60CEHKApAV/avatar_1787777711.png")
  isVerified         Boolean @default(false)
  hasUsernameChanged Boolean @default(false)
  isHeatmapPrivate   Boolean @default(false)

  verificationCode String?

  // time
  createdAt    DateTime @default(now())
  lastSyncedAt DateTime @default(now())

  // foreign key
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Topic {
  id String @id @default(uuid()) // YOUR safe Primary Key

  name String
  slug String @unique

  questions Question[]
}

model Question {
  id String @id @default(uuid())

  questionId         String @unique // Perfect for redundancy checks!
  questionFrontendId String
  title              String
  titleSlug          String @unique
  content            String
  difficulty         String

  topicTags Topic[]

  submissionsHistory SubmissionHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubmissionHistory {
  submissionId String @id // FIXED: Made LeetCode ID the primary key directly

  // Ownership
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Question Link
  questionSlug String
  question     Question @relation(fields: [questionSlug], references: [titleSlug], onDelete: Cascade)

  // Core Submission Data
  status        Int // 10, 11, 12, etc.
  statusDisplay String // "Accepted", "Memory Limit Exceeded", etc.
  lang          String // "cpp"
  langName      String // "C++"
  runtime       String // "0 ms" or "N/A"
  memory        String // "77.2 MB" or "N/A"
  timestamp     String // LeetCode sends as a string

  // Extras
  frontendId Int // Their own sequential counter
  createdAt  DateTime @default(now())

  submission Submission?
}

model Submission {
  submissionId      String            @id
  submissionHistory SubmissionHistory @relation(fields: [submissionId], references: [submissionId], onDelete: Cascade)

  runtimePercentile   Float?
  runtimeDistribution String

  memoryPercentile   Float?
  memoryDistribution String

  code      String
  timestamp BigInt

  runtimeError String?
  compileError String?

  lastTestcase   String?
  expectedOutput String?
  codeOutput     String?

  totalCorrect   Int?
  totalTestcases Int

  stdOutput String?

  previouslySolved Boolean
}