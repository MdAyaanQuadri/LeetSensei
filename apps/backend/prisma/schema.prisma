// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model College {
  id          String @id @default(uuid())
  name        String @unique      
  collegeId   String @unique      
  collegeType String @default("other")            
  city        String              
  state       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

model User {
  // userInfo
  id              String  @id @default(uuid())
  clerkId         String  @unique
  email           String  @unique
  firstName       String
  lastName        String
  username        String  @unique
  profileImageUrl String?
  //collegeInfo
  collegeId      String?
  degree         String?
  branch         String?
  graduationYear Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // foreignKey
  college       College?       @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  leetcodeStats LeetCodeStats?
}

model LeetCodeStats {
  id                    String @id @default(uuid())
  userId                String @unique
  // stats
  userName              String
  globalRank            Int    @default(5000001)  
  totalQuestionsSolved  Int    @default(0)
  mediumQuestionsSolved Int    @default(0)
  hardQuestionsSolved   Int    @default(0)
  easyQuestionsSolved   Int    @default(0)
  badges                Json   @default("[]")
  
  // days
  activeDays            Int    @default(0)
  maxStreak             Int    @default(0)
  currentStreak         Int    @default(0)

  // submissions
  submissionHeatMap     Json   @default("[]")

  // tag
  fundamentalTag        Json   @default("[]")
  intermediateTag       Json   @default("[]")
  advancedTag           Json   @default("[]")


  // profile
  avatarUrl             String  @default("https://assets.leetcode.com/users/60CEHKApAV/avatar_1787777711.png")
  isVerified            Boolean @default(false)
  hasUsernameChanged    Boolean @default(false) 
  isHeatmapPrivate      Boolean @default(false)

  verificationCode      String?

  // time
  createdAt             DateTime @default(now())
  lastSyncedAt          DateTime @default(now())

  // foreign key
  user                  User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // redundant
  // @@unique([userName,userId])
}
