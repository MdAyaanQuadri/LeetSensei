{
  "name": "clerk-chrome-extension",
  "displayName": "Clerk chrome extension",
  "version": "0.0.1",
  "description": "\"Automatically sync your solved LeetCode questions and submissions directly to your LeetSensei dashboard to track your progress.\"",
  "author": "LeetSenesei . LeetSensei.com",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@clerk/chrome-extension": "^3.1.82",
    "@clerk/clerk-react": "^5.61.9",
    "plasmo": "^0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwindcss": "3.4.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "postcss": "8.4.33",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "incognito": "split",
    "host_permissions": [
      "http://localhost/*"
    ],
    "permissions": [
      "cookies",
      "storage"
    ]
  }
}
